APP_ENV=production
POSTGRES_PASSWORD=generate-a-long-random-password
DATABASE_URL=postgresql+asyncpg://startrace:replace-with-postgres-password@postgres:5432/startrace
REDIS_URL=redis://redis:6379/0
JWT_SECRET=generate-at-least-32-random-bytes
CREDENTIAL_ENCRYPTION_KEY=generate-a-fernet-compatible-key
ADMIN_BOOTSTRAP_TOKEN=generate-a-long-random-admin-token
AUTH_SESSION_LIMIT=10
AUTH_SESSION_WINDOW_SECONDS=60
LICENSE_PUBLIC_KEY_PEM_B64=base64-encoded-public-key-used-by-desktop-user-licenses
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://provider.example/v1
AI_MODEL=server-model-name
AI_API_KEY=server-only-provider-key
API_PORT=8080

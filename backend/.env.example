APP_ENV=development
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_URL=postgresql+asyncpg://startrace:change-me@postgres:5432/startrace
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-url-safe-fernet-key
ADMIN_BOOTSTRAP_TOKEN=replace-with-admin-bootstrap-token
AUTH_SESSION_LIMIT=10
AUTH_SESSION_WINDOW_SECONDS=60
LICENSE_PUBLIC_KEY_PEM_B64=base64-encoded-public-key-used-by-desktop-user-licenses
AI_PROVIDER=anthropic
AI_BASE_URL=https://api.deepseek.com/anthropic
AI_MODEL=deepseek-v4-pro
AI_API_KEY=replace-with-shared-server-ai-key
